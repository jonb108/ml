sub meta {
    my ($href) = @_;
    my $bn = $href->{brigade_name} || '';
    my $ct = $href->{city} || '';
    my $st = $href->{state} || '';
    my $meta = '';
    if ($bn || $ct || $st) {
        if ($bn) {
            $meta .= $bn;
        }
        if ($ct) {
            if ($meta) {
                $meta .= ' - ';
            }
            $meta .= $ct;
        }
        if ($st) {
            if ($meta) {
                $meta .= ', ';
            }
            $meta .= $st;
        }
        $meta = "$meta<br>";
    }
    return $meta;
}

sub msg_fmt {
    my ($href) = @_;
    my $mid = $href->{id};
    my $align = 'center';
