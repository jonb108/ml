sub del_msgs {
    my @mids = $q->param('del_msg_id');
    if (! @mids) {
        $result = "No messages to delete.";
        return;
    }
    my $mids = join ', ', @mids;
    my $del_msgs_sth = $dbh->prepare(<<"EOS");
        
        DELETE
          FROM messages
         WHERE id in ($mids)

EOS
    my $del_m_ts_sth = $dbh->prepare(<<"EOS");
        
        DELETE
          FROM message_topic
         WHERE message_id in ($mids)

EOS
    $del_msgs_sth->execute();
    $del_m_ts_sth->execute();
    my $nmsgs = @mids;
    my $pl = $nmsgs == 1? '': 's';
    log_it("deleted $nmsgs message$pl");
    $result = "Deleted $nmsgs message$pl.";
}

sub del_topics {
    my @tids = $q->param('topic_ids');
    if (! @tids) {
        $result = "No topics to delete.";
        return;
    }
    my $tids = join ', ', @tids;
    my $del_topics_sth = $dbh->prepare(<<"EOS");

        DELETE
          FROM topics
         WHERE id in ($tids)

EOS
    my $del_m_ts_sth = $dbh->prepare(<<"EOS");

        DELETE
          FROM message_topic
         WHERE topic_id in ($tids)

EOS
    $del_topics_sth->execute();
    $del_m_ts_sth->execute();
    my $ntopics = @tids;
    my $pl = $ntopics == 1? '': 's';
    log_it("deleted $ntopics topic$pl");
    $result = "Deleted $ntopics topic$pl.";
}

sub regen {
    # orphaned ids:
    #
    # select distinct message_id
    #   from message_topic
    #  where not message_id in (select id from messages);
    #
    # select distinct topic_id
    #   from message_topic
    #  where not topic_id in (select id from topics);
    #
    my $orph_msg_sth = $dbh->prepare(<<'EOS');
        
        SELECT
      DISTINCT message_id
          FROM message_topic
         WHERE NOT message_id IN (SELECT id FROM messages)

EOS
    $orph_msg_sth->execute();
    my @mids;
    my $mids;
    while (my $href = $orph_msg_sth->fetchrow_hashref()) {
        push @mids, $href->{message_id};
    }
    if (@mids) {
        $mids = join ', ', @mids;
        $result .= "orphaned message ids: @mids<br>";
    }
    my $orph_top_sth = $dbh->prepare(<<'EOS');
        
        SELECT
      DISTINCT topic_id
          FROM message_topic
         WHERE NOT topic_id IN (SELECT id FROM topics)

EOS
    $orph_top_sth->execute();
    my @tids;
    my $tids;
    while (my $href = $orph_top_sth->fetchrow_hashref()) {
        push @tids, $href->{topic_id};
    }
    if (@tids) {
        $tids = join ', ', @tids;
        $result .= "orphaned topic ids: @tids<br>";
    }

    if ($mids || $tids) {
        $mids ||= '0';  # prevents SQL syntax error
        $tids ||= '0';
        my $del_msg_top_sth = $dbh->prepare(<<"EOS");
            
            DELETE 
              FROM message_topic
             WHERE message_id IN ($mids)
                   OR
                   topic_id IN ($tids)
EOS
        $del_msg_top_sth->execute();
    }


    # go through all messages
    #     and get its topics and set topic_desc
    # go through all topics
    #     and set its count

    # for each message...
    my $msgs_sth = $dbh->prepare(<<'EOS');

        SELECT id
          FROM messages

EOS
    # rather than creating a hash
    # with key topic id and value description...
    # gather topic descriptions and comma separate them
    #
    # we need to address duplicate message_topic records here
    # not sure yet how they arise but we can delete duplicates.
    #

=comment

    SELECT message_id, topic_id, COUNT(*) AS cnt
      FROM message_topic
  GROUP BY message_id, topic_id HAVING COUNT(*) > 1;

    This gives the message_ids with dup records.
    Go through them...
=cut
    my $desc_sth = $dbh->prepare(<<'EOS');

        SELECT description
          FROM messages m, message_topic mt, topics t
         WHERE m.id = mt.message_id
               AND t.id = mt.topic_id
               AND m.id = ?
      ORDER BY description asc

EOS
    # update topic_desc for each message
    my $upd_topic_desc_sth = $dbh->prepare(<<'EOS');

        UPDATE messages
           SET topics_desc = ?
         WHERE id = ?

EOS
    $msgs_sth->execute();
    while (my $href_msg = $msgs_sth->fetchrow_hashref()) {
        my $mid = $href_msg->{id};
        $desc_sth->execute($mid);
        my @topics;
        while (my $desc_href = $desc_sth->fetchrow_hashref()) {
            push @topics, $desc_href->{description};
        }
        my $topic_desc = join ', ', @topics;
        $upd_topic_desc_sth->execute($topic_desc, $mid);
    }
    # for each topic...
    my $topics_sth = $dbh->prepare(<<'EOS');

        SELECT id
          FROM messages

EOS
    # update the count for each topic
    my $upd_count_sth = $dbh->prepare(<<'EOS');

    UPDATE topics
       SET count = (
           SELECT count(*)
             FROM message_topic
            WHERE topic_id = ?
       ) 
     WHERE id = ?

EOS
    $topics_sth->execute();
    while (my $topic_href = $topics_sth->fetchrow_hashref()) {
        my $tid = $topic_href->{id};
        $upd_count_sth->execute($tid, $tid);
    }
    log_it('regenerated');
    $result .= 'Regenerated';
}

