        $q->td({ valign => $align, width => '9%',
                 style => 'white-space: nowrap;' },
               "<label><input type=checkbox name=del_msg_id value='$href->{id}'> "
               . gray(date($href->{mdate})->format('%D'))
               . $space
               . msg_green($href->{message})
               . $space
               . "$href->{topics_desc}"
               . "</label>\n")
    );
}

sub disp_topics {
    my $n_topics_sth = $dbh->prepare(<<"EOS");
        
        SELECT count(*)
          FROM topics

EOS
    $n_topics_sth->execute();
    my $aref = $n_topics_sth->fetchrow_arrayref();
    my $n_topics = $aref->[0];
    my $per_col = int ($n_topics/$ncol);
    my $all_topics_sth = $dbh->prepare(<<"EOS");

        SELECT id, description, count
          FROM topics
      ORDER BY description asc

EOS
    $all_topics_sth->execute();
    $result = "<form action=$cgi_bin_mla method=post>\n";
    $result .= "<input type=hidden name=cmd value='del_topics'>\n";
    $result .= "<table cellpadding=5><tr><td valign=top>\n";
    my $n = 0;
    while (my $href = $all_topics_sth->fetchrow_hashref()) {
        my $tid = $href->{id};
        my $desc = $href->{description};
        $result .= "<label>"
            . "<input type=checkbox name=topic_ids value=$tid>"
            . " $desc</label><p>\n";
        ++$n;
        if ($n >= $per_col) {
            $result .= "</td><td valign=top>\n";
            $n = 0;
        }
    }
    if ($n != 0) {
        $result .= "</td>\n";
        $n = 0;
    }
    $result .= <<'EOH';
</tr></table>
<p>
<input type=submit class=sub value="Delete Selected Topics">
</form>
EOH
}

sub search_messages {
    my $search_sth = $dbh->prepare(<<"EOS");

        SELECT *
          FROM messages
         WHERE message like '%$search_term%'
      ORDER BY mdate desc

EOS
    $search_sth->execute();
    log_it("admin search for $search_term");
    my $n = 0;
    my @rows;
    $result = '';
    while (my $href = $search_sth->fetchrow_hashref()) {
        ++$n;
        $href->{message} =~ s{\Q$search_term}
                             {<span class=highlight>$search_term</span>}xmsg;
        push @rows,  msg_fmt($href);
    }
    if ($n == 0) {
        $result = "No messages match '$search_term'.";
    }
    else {
        $result = "<form action=$cgi_bin_mla>\n" 
                . "<input type=hidden name=cmd value='del_msg'>\n"
                . $q->table({ cellpadding => 5 }, @rows)
                . "<p><input class=sub type=submit value='Delete Checked Messages'>"
                . "</form>\n";
    }
}

